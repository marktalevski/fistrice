---
import Base from '../layouts/Base.astro';
import Freediving from '../components/Freediving.jsx';
---
<Base title="Freediving · Mark T">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600&amp;display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&amp;family=JetBrains+Mono:wght@300;400;500&amp;display=swap" />
    <style is:inline>
      html,body{margin:0;height:100%;overflow:hidden;background:#f5f3ee;overscroll-behavior:none}
      a{color:inherit}a:hover{color:inherit;opacity:.6}nav a:hover{opacity:1}
      @keyframes tlFade{from{opacity:0}to{opacity:1}}
      @keyframes tlIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
      @keyframes tlR{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
      [data-scroll]::-webkit-scrollbar{width:3px}[data-scroll]::-webkit-scrollbar-thumb{background:currentColor}
    </style>
  </Fragment>
  <script is:inline>
    // arriving from Home: show its last frame until this page draws its own first one (Freediving.jsx removes it)
    try {
      const s = /from=home/.test(location.search) && sessionStorage.getItem('dive-cover');
      sessionStorage.removeItem('dive-cover');
      if (s) { const i = new Image(); i.id = 'arrive-cover'; i.alt = ''; i.src = s; i.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;z-index:50;pointer-events:none'; document.body.appendChild(i); }
    } catch (e) {}
  </script>
  <Freediving client:only="react" />
</Base>
